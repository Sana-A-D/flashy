// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  avatarUrl     String?
  password      String // Hashed password
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items               Item[]
  storageLocations    StorageLocation[]
  marketplaceAccounts MarketplaceAccount[]
  refreshTokens       RefreshToken[]
  ebayAccounts        EbayAccount[]
  subscription        Subscription?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id                String     @id @default(uuid())
  userId            String
  title             String
  description       String?
  category          String?
  brand             String?
  condition         String?
  color             String?
  size              String?
  sku               String?
  purchasePrice     Int?
  purchaseDate      DateTime?
  status            ItemStatus @default(DRAFT)
  preparationStatus String     @default("UNPREPARED") // UNPREPARED, PREPARED, READY_TO_LIST
  preparedAt        DateTime?
  readyToListAt     DateTime?
  storageLocationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                 @relation(fields: [userId], references: [id])
  storageLocation StorageLocation?     @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  images          ItemImage[]
  listings        MarketplaceListing[]
  recognition     ItemRecognition?
  listingDraft    ListingDraft?
  pricingResearch PricingResearch?
  sale            Sale?

  @@index([userId])
  @@index([status])
  @@index([storageLocationId])
  @@index([createdAt])
}

enum ItemStatus {
  DRAFT
  INVENTORY
  LISTED
  SOLD
  ARCHIVED
}

model ItemImage {
  id               String  @id @default(uuid())
  itemId           String
  storageKey       String
  originalFilename String?
  mimeType         String
  fileSize         Int
  width            Int?
  height           Int?
  sortOrder        Int     @default(0)
  isPrimary        Boolean @default(false)

  processingStatus ImageProcessingStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item     Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variants ItemImageVariant[]

  @@index([itemId])
  @@index([itemId, sortOrder])
  @@index([itemId, isPrimary])
}

model ItemImageVariant {
  id          String           @id @default(uuid())
  itemImageId String
  type        ImageVariantType
  storageKey  String
  mimeType    String
  fileSize    Int
  width       Int?
  height      Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  itemImage ItemImage @relation(fields: [itemImageId], references: [id], onDelete: Cascade)

  @@unique([itemImageId, type])
  @@index([itemImageId])
}

enum ImageProcessingStatus {
  NONE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImageVariantType {
  BACKGROUND_REMOVED
}

model ItemRecognition {
  id         String            @id @default(uuid())
  itemId     String            @unique
  status     RecognitionStatus @default(NONE)
  confidence Float? // Overall confidence if applicable

  // Structured attributes
  category        String?
  brand           String?
  model           String?
  productName     String?
  color           String?
  secondaryColors String[]
  material        String?
  style           String?
  audience        String?
  size            String?
  pattern         String?
  conditionClues  String[]
  visibleFeatures String[]

  // Identifiers
  modelNumber String?
  sku         String?
  upc         String?

  // AI metadata
  notes       String?
  provider    String?
  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

enum RecognitionStatus {
  NONE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ListingDraft {
  id     String           @id @default(uuid())
  itemId String           @unique
  status GenerationStatus @default(NONE)

  title       String?
  description String?
  category    String?
  brand       String?
  condition   String?
  color       String?
  size        String?
  attributes  Json?
  keywords    String[]
  price       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

enum GenerationStatus {
  NONE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model StorageLocation {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  items Item[]

  @@index([userId])
}

model Marketplace {
  id   String @id @default(uuid())
  name String // e.g., 'eBay', 'Poshmark'
  type String // 'EBAY', 'POSHMARK', etc.

  accounts MarketplaceAccount[]
  listings MarketplaceListing[]
}

model MarketplaceAccount {
  id                String    @id @default(uuid())
  userId            String
  marketplaceId     String
  externalAccountId String?
  encryptedTokens   String?
  expiresAt         DateTime?

  user        User                 @relation(fields: [userId], references: [id])
  marketplace Marketplace          @relation(fields: [marketplaceId], references: [id])
  listings    MarketplaceListing[]
}

model MarketplaceListing {
  id                String        @id @default(uuid())
  itemId            String
  marketplaceId     String
  externalListingId    String?
  marketplaceAccountId String?
  status               ListingStatus @default(DRAFT)
  listingUrl           String?
  listedPrice          Float?
  listedAt             DateTime?
  soldAt               DateTime?

  item                 Item                @relation(fields: [itemId], references: [id])
  marketplace          Marketplace         @relation(fields: [marketplaceId], references: [id])
  marketplaceAccount   MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id])
  sales                Sale[]
}

model Sale {
  id                   String   @id @default(uuid())
  itemId               String   @unique
  marketplaceListingId String?
  salePrice            Int
  marketplaceFees      Int      @default(0)
  shippingCost         Int      @default(0)
  otherExpenses        Int      @default(0)
  soldAt               DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  item               Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  marketplaceListing MarketplaceListing? @relation(fields: [marketplaceListingId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([marketplaceListingId])
  @@index([soldAt])
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ENDED
  ERROR
}

model PricingResearch {
  id     String         @id @default(uuid())
  itemId String         @unique
  status ResearchStatus @default(NONE)

  recommendedPrice Int?
  lowPrice         Int?
  highPrice        Int?
  confidence       ConfidenceLevel @default(LOW)
  currency         String          @default("USD")
  source           PricingSource   @default(ESTIMATE)

  factors String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

enum ResearchStatus {
  NONE
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum PricingSource {
  MARKET_COMPS
  USER_HISTORY
  ESTIMATE
  MANUAL
}

model EbayAccount {
  id            String  @id @default(uuid())
  userId        String
  environment   String // 'sandbox' or 'production'
  ebayUserId    String?
  ebayUsername  String?
  marketplaceId String  @default("EBAY_US")

  // Encrypted tokens
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime

  merchantLocationKey String?
  fulfillmentPolicyId String?
  paymentPolicyId     String?
  returnPolicyId      String?

  // Location Data
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateOrProvince     String?
  postalCode          String?
  country             String?

  connectionStatus String @default("CONNECTED") // CONNECTED, DISCONNECTED, REAUTHORIZATION_REQUIRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, environment, marketplaceId])
  @@index([userId])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum UserRole {
  USER
  ADMIN
}
