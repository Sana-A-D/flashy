PORT=3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/listingmate?schema=public"
JWT_SECRET="super-secret-key-change-in-production"
ENCRYPTION_KEY="32-byte-secret-key-change-in-prod"

# eBay Sandbox Configuration
EBAY_ENVIRONMENT="sandbox"
EBAY_CLIENT_ID="your_sandbox_client_id"
EBAY_CLIENT_SECRET="your_sandbox_client_secret"
EBAY_RU_NAME="your_sandbox_ru_name"
EBAY_OAUTH_SCOPES="https://api.ebay.com/oauth/api_scope/sell.account https://api.ebay.com/oauth/api_scope/sell.inventory"

# CORS Configuration (comma-separated origins or * in development)
CORS_ORIGIN="http://localhost:8081,https://your-app.vercel.app"

# AI Configuration
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
